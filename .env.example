# Reachable URL of the CronFleet control plane (used in node onboarding, telemetry & OIDC callback)
PUBLIC_URL=http://cronfleet.example.com:4000

# Host UID/GID that owns ./data on the Docker host
PUID=1000
PGID=1000

# Optional: set a deterministic First-Run Setup Code instead of reading a random one from container logs
# SETUP_CODE=CF-1234-ABCD

# Emergency break-glass reset: set to true and restart container to re-open the Auth Setup Wizard
RESET_AUTH=false
